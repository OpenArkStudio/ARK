cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED BUILD_DIR OR NOT EXISTS "${BUILD_DIR}/CMakeCache.txt")
    message(FATAL_ERROR "A configured BUILD_DIR is required")
endif()
if("$ENV{GITHUB_PATH}" STREQUAL "" OR NOT EXISTS "$ENV{GITHUB_PATH}" OR IS_DIRECTORY "$ENV{GITHUB_PATH}")
    message(FATAL_ERROR "An existing GITHUB_PATH file is required to export the dependency runtime directory")
endif()
load_cache("${BUILD_DIR}" READ_WITH_PREFIX runtime_
    VCPKG_INSTALLED_DIR VCPKG_TARGET_TRIPLET VCPKG_APPLOCAL_DEPS CMAKE_BUILD_TYPE)
if(NOT runtime_VCPKG_APPLOCAL_DEPS STREQUAL "OFF")
    message(FATAL_ERROR "Windows CI runtime export requires VCPKG_APPLOCAL_DEPS=OFF")
endif()
if(NOT IS_ABSOLUTE "${runtime_VCPKG_INSTALLED_DIR}" OR
   NOT runtime_VCPKG_TARGET_TRIPLET MATCHES "^[a-z0-9]+-windows(-[a-z0-9-]+)?$")
    message(FATAL_ERROR "The configured vcpkg installed root and Windows target triplet are required")
endif()
string(TOLOWER "${runtime_CMAKE_BUILD_TYPE}" configuration)
if(configuration STREQUAL "debug")
    set(suffix "/debug/bin")
elseif(configuration MATCHES "^(release|relwithdebinfo|minsizerel)$")
    set(suffix "/bin")
else()
    message(FATAL_ERROR "A known single-configuration CMAKE_BUILD_TYPE is required")
endif()
set(runtime_bin "${runtime_VCPKG_INSTALLED_DIR}/${runtime_VCPKG_TARGET_TRIPLET}${suffix}")
if(NOT IS_DIRECTORY "${runtime_bin}" OR runtime_bin MATCHES "[\r\n;]")
    message(FATAL_ERROR "The configured dependency runtime directory is missing or invalid: ${runtime_bin}")
endif()
cmake_path(NATIVE_PATH runtime_bin NORMALIZE native_bin)
file(APPEND "$ENV{GITHUB_PATH}" "${native_bin}\n")
message(STATUS "Windows CI dependency runtime directory: ${native_bin}")
