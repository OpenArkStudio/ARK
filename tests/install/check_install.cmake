cmake_minimum_required(VERSION 3.21)
# Stage an existing build, relocate it, audit exported paths and test independent
# consumers. run_isolated.cmake also removes the copied producer source/build.
if(NOT ARK_BUILD_DIR OR NOT ARK_SOURCE_DIR)
    message(FATAL_ERROR "ARK_BUILD_DIR and ARK_SOURCE_DIR are required")
endif()
if(NOT ARK_TEST_WORK)
    set(ARK_TEST_WORK "${ARK_BUILD_DIR}/install-check")
endif()
function(ark_install_run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Install consumer command failed (${result}): ${ARGV}")
    endif()
endfunction()
file(REMOVE_RECURSE "${ARK_TEST_WORK}")
file(MAKE_DIRECTORY "${ARK_TEST_WORK}")
set(original_prefix "${ARK_TEST_WORK}/original")
set(relocated_prefix "${ARK_TEST_WORK}/relocated")
set(config_args)
if(ARK_TEST_CONFIG)
    list(APPEND config_args --config "${ARK_TEST_CONFIG}")
endif()
ark_install_run("${CMAKE_COMMAND}" --install "${ARK_BUILD_DIR}" --prefix "${original_prefix}" ${config_args})
file(RENAME "${original_prefix}" "${relocated_prefix}")
file(COPY "${ARK_SOURCE_DIR}/tests/install/consumer/" DESTINATION "${ARK_TEST_WORK}/consumer")
file(GLOB_RECURSE package_files "${relocated_prefix}/*.cmake")
foreach(path IN LISTS package_files)
    file(READ "${path}" contents)
    foreach(forbidden IN ITEMS "${ARK_SOURCE_DIR}" "${ARK_BUILD_DIR}" "${original_prefix}")
        string(FIND "${contents}" "${forbidden}" occurrence)
        if(NOT occurrence EQUAL -1)
            message(FATAL_ERROR "Non-relocatable installed CMake file ${path}: ${forbidden}")
        endif()
    endforeach()
endforeach()
# Source/build removal is opt-in only for the disposable producer created by
# run_isolated.cmake, and never applies to the user's working checkout/build.
if(ARK_REMOVE_DISPOSABLE_PRODUCER)
    if(NOT EXISTS "${ARK_SOURCE_DIR}/.ark-disposable-install-producer" OR
       NOT EXISTS "${ARK_BUILD_DIR}/.ark-disposable-install-producer")
        message(FATAL_ERROR "Refusing to remove an unmarked producer source/build")
    endif()
    file(REMOVE_RECURSE "${ARK_BUILD_DIR}" "${ARK_SOURCE_DIR}")
endif()
set(prefixes "${relocated_prefix};${ARK_TEST_PREFIX_PATH}")
file(WRITE "${ARK_TEST_WORK}/consumer-cache.cmake"
    "set(CMAKE_PREFIX_PATH [==[${prefixes}]==] CACHE STRING \"\" FORCE)\n")
set(consumer_args -C "${ARK_TEST_WORK}/consumer-cache.cmake"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
if(ARK_TEST_TOOLCHAIN)
    list(APPEND consumer_args "-DCMAKE_TOOLCHAIN_FILE=${ARK_TEST_TOOLCHAIN}")
endif()
set(modes config_headers core)
file(GLOB reader_exports "${relocated_prefix}/*/cmake/ark/arkConfigReaderTargets.cmake")
if(reader_exports)
    list(APPEND modes config)
endif()
if(ARK_TEST_MYSQL)
    list(APPEND modes mysql)
endif()
foreach(mode IN LISTS modes)
    set(consumer_build "${ARK_TEST_WORK}/consumer-${mode}")
    ark_install_run("${CMAKE_COMMAND}" -S "${ARK_TEST_WORK}/consumer" -B "${consumer_build}"
        "-DARK_TEST_MODE=${mode}" ${consumer_args})
    ark_install_run("${CMAKE_COMMAND}" --build "${consumer_build}" --target check-consumer ${config_args})
endforeach()
message(STATUS "Relocated installed consumers passed: ${modes}")
