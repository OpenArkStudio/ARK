foreach(mode --pending-destruction --wrong-thread-destruction)
    message(STATUS "Checking database task contract ${mode}")
    execute_process(COMMAND "${PROGRAM}" "${mode}" RESULT_VARIABLE result TIMEOUT 15)
    if(NOT "${result}" STREQUAL "77")
        message(FATAL_ERROR "Task group contract ${mode}: expected controlled exit 77, got ${result}")
    endif()
    message(STATUS "Database task contract ${mode}: controlled exit 77")
endforeach()
