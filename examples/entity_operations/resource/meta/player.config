<xml>
<meta class="Player" type="class"/>
<meta class="Player" field_name="name" type="string"/>
<meta class="Player" field_name="gender" type="int"/>
<meta class="Player" field_name="career" type="int"/>
<meta class="Player" field_name="camp" type="int"/>
<meta class="Player" field_name="last_map_id" type="int"/>
<meta class="Player" field_name="level" type="int"/>
<meta class="Player" field_name="items" type="table" type_class="ItemBag"/>
<meta class="Player" field_name="bag" type="container" type_class="ItemBag"/>
<meta class="ItemBag" type="class"/>
<meta class="ItemBag" field_name="guid" type="int64"/>
<meta class="ItemBag" field_name="config_id" type="uint32"/>
<meta class="ItemBag" field_name="count" type="int"/>
</xml>
