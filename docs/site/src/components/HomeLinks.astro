---
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { CardGrid } from "@/components/ui/card-grid";
import { LinkCard } from "@/components/ui/link-card";
interface Props { chinese: boolean; }
const { chinese } = Astro.props;
const destinations = [
  ["get-started/installation", "Install and build", "安装与构建", "Build C++20 applications and tests.", "构建 C++20 应用与测试。", "ph:download-simple"],
  ["concepts/architecture", "Understand ARK", "了解 ARK", "Applications, plugins, modules and lifecycle.", "应用、插件、模块与生命周期。", "ph:book-open-text"],
  ["guides/plugins", "Create a plugin", "创建插件", "Register modules and use the provided examples.", "注册模块，运行仓库示例。", "ph:plugs-connected"],
  ["networking", "Networking and tests", "网络与测试", "Use arknet and run regression tests.", "使用 arknet，运行网络回归测试。", "ph:gauge"],
];
---
<section aria-labelledby="where-to-go-next">
  <h2 id="where-to-go-next">{chinese ? "接下来" : "Where to go next"}</h2>
  <CardGrid data-home-links>
    {destinations.map(([slug,en,zh,description,summary,icon]) => <LinkCard title={chinese ? zh : en}
      description={chinese ? summary : description} icon={icon}
      href={withBase((chinese ? "/zh/" : "/") + slug, import.meta.env.BASE_URL)} />)}
  </CardGrid>
</section>
